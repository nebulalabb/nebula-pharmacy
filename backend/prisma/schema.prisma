generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  salesOrders      SalesOrder[]
  stockAdjustments StockAdjustment[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Supplier {
  id        String          @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id                String   @id @default(uuid())
  name              String
  activeIngredient  String?  @map("active_ingredient")
  strength          String?
  dosageForm        String?  @map("dosage_form")
  unit              String
  barcode           String?  @unique
  salePrice         Decimal  @map("sale_price") @db.Decimal(12, 2)
  defaultCost       Decimal  @default(0) @map("default_cost") @db.Decimal(12, 2)
  requiresLotTracking Boolean @default(true) @map("requires_lot_tracking")
  minStockLevel     Int      @default(0) @map("min_stock_level")
  isActive          Boolean  @default(true) @map("is_active")
  categoryId        String?  @map("category_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category          Category?          @relation(fields: [categoryId], references: [id])
  inventoryBatches  InventoryBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems   SalesOrderItem[]
  stockAdjustments  StockAdjustment[]

  @@map("products")
}

model PurchaseOrder {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  totalCost  Decimal  @map("total_cost") @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  productId       String        @map("product_id")
  lotNumber       String?       @map("lot_number")
  expiryDate      DateTime?     @map("expiry_date")
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  inventoryBatch  InventoryBatch?

  @@map("purchase_order_items")
}

model InventoryBatch {
  id                  String    @id @default(uuid())
  productId           String    @map("product_id")
  purchaseOrderItemId String?   @unique @map("purchase_order_item_id")
  lotNumber           String?   @map("lot_number")
  expiryDate          DateTime? @map("expiry_date")
  quantityRemaining   Int       @map("quantity_remaining")
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  product             Product          @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  salesOrderItems     SalesOrderItem[]
  stockAdjustments    StockAdjustment[]

  @@map("inventory_batches")
}

model SalesOrder {
  id            String        @id @default(uuid())
  cashierId     String        @map("cashier_id")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  note          String?
  soldAt        DateTime      @default(now()) @map("sold_at")

  cashier       User            @relation(fields: [cashierId], references: [id])
  items         SalesOrderItem[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id           String   @id @default(uuid())
  salesOrderId String   @map("sales_order_id")
  productId    String   @map("product_id")
  batchId      String?  @map("batch_id")
  quantity     Int
  salePrice    Decimal  @map("sale_price") @db.Decimal(12, 2)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(12, 2)

  salesOrder   SalesOrder      @relation(fields: [salesOrderId], references: [id])
  product      Product         @relation(fields: [productId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])

  @@map("sales_order_items")
}

model StockAdjustment {
  id          String         @id @default(uuid())
  productId   String         @map("product_id")
  batchId     String?        @map("batch_id")
  type        AdjustmentType
  quantity    Int
  reason      String?
  createdById String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  product     Product         @relation(fields: [productId], references: [id])
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@map("stock_adjustments")
}
